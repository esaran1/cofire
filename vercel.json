{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "app",
      "framework": "nextjs",
      "installCommand": "bash ../scripts/vercel_build.sh install",
      "buildCommand": "bash ../scripts/vercel_build.sh build"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "cofire.deploy.vercel_app:app",
      "bindings": [
        { "type": "service", "service": "web", "format": "url", "env": "WEB_URL" }
      ],
      "functions": {
        "cofire/deploy/vercel_app.py": {
          "excludeFiles": "{app/**,film/**,research/**,tests/**,docs/**,logs/**,scripts/**,.github/**,.venv/**,.vercel-tools/**,artifacts/ship/domains/**,artifacts/ship/open/**,data/raw/**,data/cache/**,data/processed*/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
