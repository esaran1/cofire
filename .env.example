# Copy to .env. Core pipeline (data, train, calibrate, hindcast) runs with
# every key left blank.

# 1 = Larimer County, 2019–2026. 0 = statewide Colorado, 2004–present.
COFIRE_DEV_SUBSET=1

# Paths (optional overrides)
COFIRE_DATA_DIR=data
COFIRE_ARTIFACTS_DIR=artifacts
COFIRE_LOG_DIR=logs

# SQLite by default. Postgres: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///data/cofire.db

# Optional observation/nowcast sources. Leave blank to skip.
SYNOPTIC_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
COFIRE_ENABLE_NFMD=0
COFIRE_ENABLE_RAWS=0
COFIRE_ENABLE_SMAP=0
COFIRE_ENABLE_HRRR=0
COFIRE_ENABLE_HLS=0
COFIRE_EXTERNAL_DROUGHT_NC=data/external/drought_pred.nc

# API / web
COFIRE_API_HOST=127.0.0.1
COFIRE_API_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
