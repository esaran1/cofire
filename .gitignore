app/playwright-report/
app/blob-report/
*.nc
*.tif
*.tiff
*.zip
.DS_Store
uv.lock.bak
/package-lock.json

# Regenerable pipeline intermediates. The reports, metrics, run log and the
# demo fixture are committed; the bulk parquet/JSON they were computed from is
# not, because `make train calibrate export` rebuilds it.
artifacts/predictions/
artifacts/forecast_index.json
artifacts/calibration/
artifacts/training_stats.pkl
artifacts/frontend/screens/*.png
!artifacts/frontend/screens/.gitkeep

# Per-domain bundles are rebuilt from artifacts/ship/forecast_issues.parquet by
# `python -m cofire.ship.bundles`; demo/ keeps the committed copy make demo serves.
artifacts/ship/domains/
artifacts/ship/open/
artifacts/ship/open_demo/
# Built by scripts/build_static.sh from the bundles.
app/public/data/

# v1.2 intermediate predictions (regenerable, large)
data/v12/

# MapLibre's worker, copied from node_modules on install
app/public/maplibre/

# The Colorado basemap extract (51 MB), kept as the 'basemap' release asset
app/public/tiles/
app/playwright-report-static/
